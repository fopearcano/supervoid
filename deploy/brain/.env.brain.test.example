# SUPERVOID Brain — SMALL FALLBACK / TEST PROFILE.
#
# A smaller, cheaper model for CI, laptops, and end-to-end harness validation.
# Selected EXCLUSIVELY via environment variables — no compose or code edits:
#
#   cp deploy/brain/.env.brain.test.example .env.brain.test
#   ./deploy/brain/scripts/vllm-start.sh --env-file .env.brain.test
#   ./deploy/brain/scripts/vllm-smoke.sh --env-file .env.brain.test
#
# Everything not set here falls back to the compose defaults.

VLLM_IMAGE=vllm/vllm-openai:v0.20.0

# Small instruct model with tool-calling support; ~1-2 GB VRAM.
VLLM_MODEL=Qwen/Qwen3-0.6B
VLLM_SERVED_MODEL_NAME=supervoid-brain

VLLM_HOST=0.0.0.0
VLLM_PORT=8000
VLLM_BIND_ADDR=127.0.0.1

# Tiny footprint so it runs on modest GPUs.
VLLM_TENSOR_PARALLEL_SIZE=1
VLLM_MAX_MODEL_LEN=8192
VLLM_GPU_MEMORY_UTILIZATION=0.50
VLLM_MAX_NUM_SEQS=32
VLLM_DTYPE=auto

VLLM_ENABLE_PREFIX_CACHING=1
VLLM_ENABLE_CHUNKED_PREFILL=1
VLLM_ENABLE_REQUEST_ID_HEADERS=1
VLLM_TRUST_REMOTE_CODE=1

VLLM_TOOL_CALL_PARSER=hermes
VLLM_QUANTIZATION=

# Use a key in CI too, to exercise the auth path.
VLLM_API_KEY=test-key
HUGGING_FACE_HUB_TOKEN=

BENCH_CONCURRENCY=4
BENCH_REQUESTS=12
BENCH_MAX_TOKENS=64
