# SUPERVOID Brain — LibreChat deployment env.
#
#   cp deploy/brain/.env.librechat.example .env.librechat   # at the repo root
#   # then fill in the SECRETS below (generate, do not reuse the placeholders)
#   python deploy/brain/scripts/validate_librechat_config.py --env-file .env.librechat
#   docker compose -f deploy/brain/docker-compose.librechat.yml --env-file .env.librechat up -d
#
# Generate strong secrets:
#   JWT_SECRET / JWT_REFRESH_SECRET / MEILI_MASTER_KEY:  openssl rand -hex 32
#   CREDS_KEY:  openssl rand -hex 32      (64 hex chars / 32 bytes)
#   CREDS_IV:   openssl rand -hex 16      (32 hex chars / 16 bytes)
#   MCP_SERVICE_TOKEN:  openssl rand -hex 32   (MUST match the SUPERVOID backend)

# --- pinned upstream images (re-pin against upstream release notes) ---
LIBRECHAT_IMAGE=ghcr.io/danny-avila/librechat:v0.7.8
LIBRECHAT_MONGO_IMAGE=mongo:7.0
LIBRECHAT_MEILI_IMAGE=getmeili/meilisearch:v1.12

# --- networking (private) ---
# LibreChat binds to loopback only; reach it via the SUPERVOID reverse proxy.
LIBRECHAT_BIND_ADDR=127.0.0.1
LIBRECHAT_PORT=3080
LIBRECHAT_PUBLISH_PORT=3080
BRAIN_NETWORK_NAME=supervoid-brain

# Where LibreChat reaches the SUPERVOID backend (Brain Gateway + MCP) on the
# shared private network. The backend must be attached to BRAIN_NETWORK_NAME.
SUPERVOID_BACKEND_HOST=supervoid-backend
SUPERVOID_BACKEND_PORT=8000
# The served model alias the Brain Gateway advertises (brain_gateway_model).
SUPERVOID_BRAIN_MODEL=supervoid-brain
# The MCP URL LibreChat connects to. This compose BUNDLES the signing shim
# (service `mcp-sign-proxy`, network alias `supervoid-mcp-sign-proxy`) which adds
# the service token + HMAC signature over the user-context, so the default below
# works out of the box — no separate setup. See docs/MCP_SERVER.md.
SUPERVOID_MCP_URL=http://supervoid-mcp-sign-proxy:8092/mcp
# Where the shim forwards (the SUPERVOID backend's /mcp). Leave blank to derive
# it from SUPERVOID_BACKEND_HOST:SUPERVOID_BACKEND_PORT/mcp; set to override.
MCP_UPSTREAM_URL=

# --- accounts ---
# Set ALLOW_REGISTRATION=true ONLY for the first boot to create the admin, then
# set it back to false and restart.
LIBRECHAT_ALLOW_REGISTRATION=false
LIBRECHAT_ALLOW_EMAIL_LOGIN=true
LIBRECHAT_ENDPOINTS=custom

# --- file + rate limits ---
LIBRECHAT_LIMIT_CONCURRENT_MESSAGES=2
LIBRECHAT_LIMIT_MESSAGE_USER=40
LIBRECHAT_LIMIT_MESSAGE_WINDOW=60

# --- SECRETS (REQUIRED — replace every value below) ---
JWT_SECRET=CHANGE_ME_openssl_rand_hex_32
JWT_REFRESH_SECRET=CHANGE_ME_openssl_rand_hex_32
CREDS_KEY=CHANGE_ME_openssl_rand_hex_32
CREDS_IV=CHANGE_ME_openssl_rand_hex_16
MEILI_MASTER_KEY=CHANGE_ME_openssl_rand_hex_32
# Must EXACTLY match MCP_SERVICE_TOKEN on the SUPERVOID backend.
MCP_SERVICE_TOKEN=CHANGE_ME_openssl_rand_hex_32
