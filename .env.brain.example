# SUPERVOID Brain — vLLM deployment environment (PRODUCTION CANDIDATE).
#
# Copy to `.env.brain` on the dedicated AI workstation and edit:
#   cp .env.brain.example .env.brain
# The scripts under deploy/brain/scripts/ read `.env.brain` by default
# (override with BRAIN_ENV_FILE=/path or `--env-file /path`).
#
# NOTHING here is baked into application logic: SUPERVOID code references the
# *served model name* (VLLM_SERVED_MODEL_NAME), never the Hugging Face id.

# ---------------------------------------------------------------------------
# Image — PIN a tested release (never `latest`). v0.20.0 is a known, published
# tag that supports Qwen3 + tool/structured outputs. Before production, confirm
# the tag exists and is validated for your GPU/CUDA, and prefer pinning by
# digest, e.g.  VLLM_IMAGE=vllm/vllm-openai@sha256:<digest>
# Find tags: https://hub.docker.com/r/vllm/vllm-openai/tags
# ---------------------------------------------------------------------------
VLLM_IMAGE=vllm/vllm-openai:v0.20.0

# ---------------------------------------------------------------------------
# Model — documented production candidate (a strong, efficient MoE instruct
# model with tool calling). Swap freely; keep VLLM_SERVED_MODEL_NAME stable so
# the rest of the system is decoupled from the checkpoint.
# ---------------------------------------------------------------------------
VLLM_MODEL=Qwen/Qwen3-30B-A3B-Instruct-2507
VLLM_SERVED_MODEL_NAME=supervoid-brain

# ---------------------------------------------------------------------------
# Network binding — PRIVATE. Loopback-only by default. NEVER set VLLM_BIND_ADDR
# to 0.0.0.0, and NEVER place vLLM behind the internet-facing reverse proxy.
# For a Gateway on another LAN host, set VLLM_BIND_ADDR to a private LAN IP.
# ---------------------------------------------------------------------------
# VLLM_HOST is the address vLLM listens on INSIDE the container — leave it at
# 0.0.0.0 (do NOT set 127.0.0.1, or the host port mapping can't reach it).
# Privacy is enforced by VLLM_BIND_ADDR below, not by VLLM_HOST.
VLLM_HOST=0.0.0.0
VLLM_PORT=8000
VLLM_BIND_ADDR=127.0.0.1
# VLLM_PUBLISH_PORT=8000     # host port; defaults to VLLM_PORT

# ---------------------------------------------------------------------------
# Capacity / hardware
# ---------------------------------------------------------------------------
VLLM_TENSOR_PARALLEL_SIZE=1
# Conservative initial context limit (NOT the model maximum). Raise only after
# validating VRAM headroom on your hardware.
VLLM_MAX_MODEL_LEN=32768
VLLM_GPU_MEMORY_UTILIZATION=0.90
VLLM_MAX_NUM_SEQS=256
VLLM_DTYPE=auto
VLLM_GPU_COUNT=all

# ---------------------------------------------------------------------------
# Features
# ---------------------------------------------------------------------------
VLLM_ENABLE_PREFIX_CACHING=1      # Automatic Prefix Caching
VLLM_ENABLE_CHUNKED_PREFILL=1     # chunked prefill (where supported)
VLLM_ENABLE_REQUEST_ID_HEADERS=1  # echo X-Request-Id (or mint uuid4)
VLLM_TRUST_REMOTE_CODE=1          # Qwen3 needs trust-remote-code

# ---------------------------------------------------------------------------
# Tool calling — automatic tool choice is enabled ONLY when a parser is set.
# Qwen3 uses the `hermes` parser. The chat template MUST match the parser; if
# tools never fire, set VLLM_CHAT_TEMPLATE to the model's tool-use template.
# ---------------------------------------------------------------------------
VLLM_TOOL_CALL_PARSER=hermes
# VLLM_CHAT_TEMPLATE=/path/to/tool_use_template.jinja
# VLLM_REASONING_PARSER=          # leave empty for -Instruct (non-thinking)
# VLLM_GUIDED_DECODING_BACKEND=   # leave empty for auto (strict schema outputs)

# ---------------------------------------------------------------------------
# Quantization — leave EMPTY for the full-precision/native checkpoint. Do NOT
# assume a community AWQ/GPTQ checkpoint works: follow the validation procedure
# in docs/VLLM_DEPLOYMENT.md before setting this in production.
# ---------------------------------------------------------------------------
VLLM_QUANTIZATION=
# VLLM_EXTRA_ARGS=                 # raw passthrough, e.g. "--kv-cache-dtype fp8"

# ---------------------------------------------------------------------------
# Secrets — set a strong API key in any networked deployment. Read natively by
# vLLM (never placed on the command line). HF token only for gated models.
# ---------------------------------------------------------------------------
VLLM_API_KEY=change-me-strong-random-key
HUGGING_FACE_HUB_TOKEN=

# ---------------------------------------------------------------------------
# Smoke/bench client knobs (used by scripts/*.sh)
# ---------------------------------------------------------------------------
# BRAIN_SMOKE_BASE_URL=http://127.0.0.1:8000   # override if testing remotely
BENCH_CONCURRENCY=8
BENCH_REQUESTS=32
BENCH_MAX_TOKENS=128
