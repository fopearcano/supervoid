APP_NAME=SUPERVOID Publishing
ENVIRONMENT=development
DEBUG=true

# SQLite by default; swap for a PostgreSQL DSN when migrating.
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/supervoid
DATABASE_URL=sqlite:///./supervoid.db
DATABASE_ECHO=false

# Schema preparation at startup (see docs/MIGRATIONS.md):
#   create_all (default) -> build the schema directly; fresh dev databases
#   migrate              -> Alembic; adopts an existing DB (stamp) then upgrades
#   skip                 -> do nothing; run migrations out-of-band
# DB_INIT_STRATEGY=create_all

# Authentication — replace SECRET_KEY in any non-development deployment.
SECRET_KEY=supervoid-dev-secret-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Local file storage root for attachment uploads. The directory is
# created on demand and gitignored.
# STORAGE_PATH=./storage

# AI integration. Default `dry_run` ships canned, deterministic
# responses so the system runs end-to-end without network access.
#
# AI_PROVIDER=dry_run | openai | openrouter | lm_studio | openai_compatible
# AI_BASE_URL=http://localhost:1234/v1
# AI_API_KEY=
# AI_MODEL=gpt-4o-mini
# AI_REQUEST_TIMEOUT=60
